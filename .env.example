# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every value below is a placeholder. Nothing real belongs in this file.

# Which environment this process is running in. Anything other than
# "production" is treated as development. The only thing it changes is how
# strict the server is about SECRET_KEY below.
ENVIRONMENT=development

# Signs the access tokens the API issues. Use at least 32 random characters,
# and a different one per deployment.
#
# If ENVIRONMENT is "production" and this is missing or shorter than 32
# characters, the server refuses to start: the alternative is a server that
# issues tokens anyone could forge while looking perfectly healthy. In
# development a random key is generated at startup instead, and one warning
# line says so, which means tokens stop working when the server restarts.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters

# Database connection string, read by src/db/session.py. Defaults to a local
# SQLite file in the project root when unset.
DATABASE_URL=sqlite:///./app.db

# Examples for other backends. SQLAlchemy 2.x URL format.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/mentor_pricing

# The origins a browser may call the API from, as a comma-separated list.
# Defaults to the local Next.js development server on both of the addresses it
# answers on. An origin is a scheme, a host and a port, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# What the seeded demonstration accounts sign in with, used by
# scripts/seed_demo_mentors.py. They are fictional accounts on example.com,
# which can never belong to anyone, and the seed prints their addresses and
# this password at the end of a run. Defaults to Pathwise-demo-1 when unset.
DEMO_PASSWORD=Pathwise-demo-1

# Where scripts/build_demo_activity.py reads the raw files from. Both default
# to the project's own data/raw, so these are only needed when the files live
# somewhere else.
# REVIEWS_FILE=data/raw/reviews.csv
# CALENDAR_FILE=data/raw/calendar.csv
