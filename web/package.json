{
  "name": "career-mentor-web",
  "version": "1.0.0",
  "private": true,
  "description": "Mentor-facing web application for the session pricing recommendation system.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "9.1.2",
    "jsdom": "25.0.1",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
